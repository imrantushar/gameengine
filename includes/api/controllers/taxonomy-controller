<?php

namespace Gamify\API\Controllers;

use Gamify\API\BaseController;

class TaxonomyController extends BaseController
{

    protected $rest_base = 'taxonomies';

    public function register_routes()
    {
        register_rest_route($this->namespace, '/' . $this->rest_base . '/(?P<tax>[a-zA-Z0-9_\-]+)', array(
            array(
                'methods'             => \WP_REST_Server::READABLE,
                'callback'            => array($this, 'get_terms'),
                'permission_callback' => array($this, 'admin_permission_check'),
            ),
            array(
                'methods'             => \WP_REST_Server::CREATABLE,
                'callback'            => array($this, 'create_term'),
                'permission_callback' => array($this, 'admin_permission_check'),
            ),
        ));

        register_rest_route($this->namespace, '/' . $this->rest_base . '/(?P<tax>[a-zA-Z0-9_\-]+)/(?P<id>[\d]+)', array(
            array(
                'methods'             => \WP_REST_Server::EDITABLE,
                'callback'            => array($this, 'update_term'),
                'permission_callback' => array($this, 'admin_permission_check'),
            ),
            array(
                'methods'             => \WP_REST_Server::DELETABLE,
                'callback'            => array($this, 'delete_term'),
                'permission_callback' => array($this, 'admin_permission_check'),
            ),
        ));
    }

    public function get_terms($request)
    {
        $tax   = sanitize_text_field($request['tax']);
        $terms = get_terms(array('taxonomy' => $tax, 'hide_empty' => false));

        $response = array();
        foreach ($terms as $term) {
            $response[] = array(
                'id'          => $term->term_id,
                'name'        => $term->name,
                'slug'        => $term->slug,
                'description' => $term->description,
                'parent'      => $term->parent,
            );
        }
        return new \WP_REST_Response($response, 200);
    }

    public function create_term($request)
    {
        $params = $request->get_json_params();
        $tax    = sanitize_text_field($request['tax']);

        $term = wp_insert_term(sanitize_text_field($params['name']), $tax, array(
            'description' => sanitize_textarea_field($params['description'] ?? ''),
            'slug'        => sanitize_title($params['slug'] ?? ''),
            'parent'      => absint($params['parent'] ?? 0),
        ));

        if (is_wp_error($term)) {
            return new \WP_Error('error', $term->get_error_message(), array('status' => 400));
        }
        return new \WP_REST_Response($term, 200);
    }

    public function update_term($request)
    {
        $id     = absint($request['id']);
        $tax    = sanitize_text_field($request['tax']);
        $params = $request->get_json_params();

        $updated = wp_update_term($id, $tax, array(
            'name'        => sanitize_text_field($params['name']),
            'description' => sanitize_textarea_field($params['description'] ?? ''),
            'parent'      => absint($params['parent'] ?? 0),
        ));

        return new \WP_REST_Response($updated, 200);
    }

    public function delete_term($request)
    {
        wp_delete_term(absint($request['id']), sanitize_text_field($request['tax']));
        return new \WP_REST_Response(array('success' => true), 200);
    }
}
