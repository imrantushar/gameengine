# The release packager and what it leaves behind (npm run dist).
build.config.json
.build-cache
/dist

# Dev-only Composer packages. npm run dist installs with --no-dev, but a zip
# built from a dev vendor tree (npm run dist:zip) must not ship them either.
vendor/bin/
vendor/php-stubs/

# Source code and build tooling. The zip carries only what WordPress runs. The
# uncompiled source and build setup live in the public repository readme.txt
# links to (https://github.com/imrantushar/gameengine), which meets WordPress.org's
# human-readable source rule, and each file in assets/build/ names its source.
# composer.json still ships: WordPress.org expects it wherever vendor/ does.
/dev_gameengine/
/assets/scss/
/build-tools/
/package.json
/package-lock.json
/webpack.config.js
/tailwind.config.js
/postcss.config.js
/jsconfig.json
/composer.lock
/README.md

# Images nothing in the plugin uses.
/assets/images/logo_full.svg
/assets/images/logo-text.svg
/assets/images/black_white_logo_full.svg
